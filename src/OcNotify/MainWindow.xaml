<Window x:Class="OcNotify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OcNotify"
        Width="392"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized">
    <!--
      气泡容器窗口：
      - AllowsTransparency=True + Background=null：窗口完全透明，任何位置都看不到窗口本体
      - 毛玻璃仅体现在卡片背景半透明（窗口级 backdrop 会刷出可见矩形，已弃用）
      - SizeToContent=Height 随内容增高，但 RootGrid.MinHeight 由 code-behind 预留
        maxVisible 槽位 → 气泡活动期间窗口高度恒定（杜绝窗口缩放闪烁）
      - CardsPanel 向固定边对齐（top 锚点贴上边 / bottom 锚点贴下边，code-behind 设置）：
        收拢空隙由此决定方向——top 向上收拢（下方卡上移）、bottom 向下收拢（上方卡下移）
      - Background=null 区域点击穿透到桌面（含面板上方/下方的预留空白区）
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{x:Null}">
        <!--
          垂直 Margin=0：锚点边只算配置的16px，不被容器内边距干扰；
          卡片间距由 code-behind 按锚点方向加在卡片上（上角在下、下角在上）。
          水平 Margin=12：卡片(360)与窗口(392)之间的左右留白。
          VerticalAlignment 由 code-behind 按锚点切换（Top/Bottom），保证收拢方向正确。
        -->
        <StackPanel x:Name="CardsPanel"
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    Background="{x:Null}"
                    Margin="12,0"/>
    </Grid>
</Window>
